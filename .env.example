# --- Scam Guard configuration (copy to .env and fill in your keys) ---

# LLM provider for deep risk analysis (any OpenAI-compatible API):
# openai | groq | google | xai | local (Ollama) | custom (set SCAMGUARD_LLM_BASE_URL)
SCAMGUARD_LLM_PROVIDER=openai
SCAMGUARD_LLM_API_KEY=
SCAMGUARD_LLM_MODEL=gpt-4o-mini
# Optional: override the API base URL (e.g. your own proxy / Ollama at http://localhost:11434/v1)
SCAMGUARD_LLM_BASE_URL=
SCAMGUARD_LLM_TEMPERATURE=0.1
SCAMGUARD_LLM_TIMEOUT=30
SCAMGUARD_LLM_MAX_TOKENS=800

# Hybrid mode: heuristics always run; the LLM refines the result.
SCAMGUARD_USE_HEURISTICS=1
# If the heuristic pre-screen already hits this score, the final score is never
# downgraded below it (conservative flagging).
SCAMGUARD_HARD_FLAG_THRESHOLD=70

# Fish Audio S2.1 Pro — voice incident briefings (TTS)
SCAMGUARD_FISH_API_KEY=
SCAMGUARD_FISH_MODEL=S2.1
SCAMGUARD_FISH_BASE_URL=https://api.fish.audio
# Optional reference voice ID (voice clone)
SCAMGUARD_FISH_REFERENCE_ID=
SCAMGUARD_FISH_TIMEOUT=90

# Storage / behaviour
SCAMGUARD_DB_PATH=data/scamguard.db
SCAMGUARD_SEED_ON_START=1
# Delay between streamed transcript lines (seconds) — lower for tests/demos
SCAMGUARD_SIM_SEGMENT_DELAY=0.5
# Comma separated origins for CORS
SCAMGUARD_CORS_ORIGINS=*
